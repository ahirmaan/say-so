# None of this is required for a normal install - Say.so works with no
# .env file at all (talks to the hosted backend by default, F9 by default).
# Only set these if you want to override something:

# Point at a different backend - e.g. a locally-running one during
# development (see backend/README or just `cd backend && npm start`).
# BACKEND_URL=http://localhost:8787
# BACKEND_SHARED_SECRET=

# A different hotkey instead of F9.
# SAYSO_HOTKEY=F9
