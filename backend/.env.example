GROQ_API_KEY=
FISH_API_KEY=
OPENROUTER_API_KEY=

# Shared secret the client app must send as "Authorization: Bearer <this>".
# Generate any long random string - e.g. `openssl rand -hex 32`.
APP_SHARED_SECRET=

# Hard cap on total requests/day across every user combined - the real
# protection against a surprise bill once this is publicly installable.
DAILY_REQUEST_CAP=300

PORT=8787
